{
  "name": "control-room",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "shot": "node scripts/shot.mjs",
    "fixture:build": "tsx scripts/fixtures/build-fixture.ts",
    "fixture:tmux": "tsx scripts/fixtures/tmux-panes.ts",
    "fixture": "npm run fixture:build && npm run fixture:tmux",
    "shot:fixture": "CR_PR_FIXTURE=fixture-rec-ready CR_JIRA_FIXTURE=\"$PWD/scripts/fixtures/jira-issues.json\" CR_SESSIONS_DIR=\"$PWD/.dev/fixture/sessions\" CR_CLAUDE_PROJECTS_DIR=\"$PWD/.dev/fixture/claude-projects\" node scripts/shot.mjs",
    "contrast-check": "tsx src/renderer/src/theme/contrast-check.ts",
    "verify:files-write": "tsx scripts/verify-files-write.ts",
    "verify:status-key-stability": "tsx scripts/verify-status-key-stability.ts",
    "generate-tokens-css": "tsx scripts/generate-tokens-css.ts",
    "gate": "node scripts/gate.mjs",
    "install-app": "node scripts/install-app.mjs",
    "gate:fast": "node scripts/gate-fast.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "0.7.2",
    "lucide-react": "^1.47.0",
    "node-pty": "^1.1.0",
    "parse-diff": "0.12.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true
  }
}
